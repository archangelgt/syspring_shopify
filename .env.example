# Credenciales de la app (Partner Dashboard → App → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# URL pública de la app (debe coincidir con Partner Dashboard)
HOST=https://syspricing.shopify.erpsys.pro

# Título / subtítulo del header
APP_TITLE=SysPricing
APP_SUBTITLE=B2B Price Engine

# Scopes Phase 1 (productos + clientes para metafields de segmento)
SCOPES=read_products,write_products,read_customers,write_customers

# Opcional
# PORT=3000
# DATA_DIR=/app/data
# TZ=America/Guatemala
# CUSTOMER_AUTH_MODE=dev   # portal/Flutter local: headers X-Shopify-Customer-Id + X-Shopify-Shop-Domain
