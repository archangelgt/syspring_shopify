# Credenciales de la app SomosFace (Partner Dashboard → App NUEVA → Client credentials)
# La app original (client_id 14db…) está locked a seraph-systems Plus org.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# URL pública de esta instancia
HOST=https://syspricing.shopify.somosface.erpsys.pro

# Título / subtítulo del header
APP_TITLE=SysPricing
APP_SUBTITLE=B2B Price Engine · SomosFace

# Scopes Phase 1 (+ discounts for cart/checkout B2B Function)
SCOPES=read_products,write_products,read_customers,write_customers,read_discounts,write_discounts

# Opcional
# PORT=3000
# DATA_DIR=/app/data
# TZ=America/Guatemala
# CUSTOMER_AUTH_MODE=dev   # portal/Flutter local: headers X-Shopify-Customer-Id + X-Shopify-Shop-Domain
