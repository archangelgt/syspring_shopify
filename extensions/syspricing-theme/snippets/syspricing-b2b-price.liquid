{%- doc -%}
  SYSPRICING B2B price — original (line-through) + B2B side by side when available.
  {% render 'syspricing-b2b-price', product_resource: product_resource %}
{%- enddoc -%}

{%- liquid
  assign sp_product = product_resource | default: product
  if sp_product == blank
    echo ''
    break
  endif

  assign sp_variant = sp_product.selected_or_first_available_variant
  assign prices_map = sp_variant.metafields.syspricing.prices.value
  assign config = shop.metafields.syspricing.function-config.value
  assign best_price = nil
  assign best_tag = nil
  assign best_priority = -999999
  assign tags_csv = customer.tags | join: ','
  assign catalog_price = sp_variant.price
  assign sp_logged_in = 0
  if customer != blank
    assign sp_logged_in = 1
  endif

  if customer != blank and prices_map != blank
    for tag in customer.tags
      assign tag_key = tag | strip | downcase
      assign candidate = prices_map[tag_key]
      if candidate == blank
        continue
      endif
      assign prio = 0
      if config != blank and config.priority != blank and config.priority[tag_key] != blank
        assign prio = config.priority[tag_key] | plus: 0
      endif
      if best_price == blank or prio > best_priority
        assign best_price = candidate
        assign best_tag = tag_key
        assign best_priority = prio
      endif
    endfor
  endif
-%}

<div
  id="syspricing-b2b-price"
  class="syspricing-b2b-price"
  data-logged-in="{{ sp_logged_in }}"
  data-variant-id="{{ sp_variant.id }}"
  data-customer-id="{{ customer.id }}"
  data-customer-tags="{{ tags_csv | escape }}"
  data-compare-price="{{ catalog_price }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-proxy="/apps/syspricing/prices"
  {% if best_price == blank %}hidden{% endif %}
>
  <span class="syspricing-compare"{% if best_price == blank %} hidden{% endif %}>
    {{ catalog_price | money }}
  </span>
  <span class="syspricing-amount">
    {%- if best_price != blank -%}Q{{ best_price }}{%- endif -%}
  </span>
  <span class="syspricing-tag">{% if best_tag != blank %}Precio Especial{% endif %}</span>
  <div class="syspricing-status" style="display:none"></div>
</div>

{{ 'https://syspricing.shopify.somosface.erpsys.pro/storefront/syspricing-price.css?v=18' | stylesheet_tag }}
<script src="https://syspricing.shopify.somosface.erpsys.pro/storefront/syspricing-price.js?v=18" defer></script>
